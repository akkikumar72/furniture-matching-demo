{
  "name": "furniture-matching-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "catalogue:prepare": "tsx --env-file-if-exists=.env.local scripts/prepare-catalogue.ts",
    "catalogue:import": "tsx --env-file-if-exists=.env.local scripts/import-catalogue.ts",
    "setup:check": "tsx --env-file-if-exists=.env.local scripts/check-setup.ts",
    "examples:warm": "node --import tsx --env-file-if-exists=.env.local scripts/cache-examples.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@supabase/supabase-js": "2.117.1",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.2.0",
    "next": "16.3.6",
    "openai": "7.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "undici": "^7.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
